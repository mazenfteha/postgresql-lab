{
  "info": {
    "name": "pg-lab",
    "description": "Postgres Feature Lab. One folder per phase. Change {{baseUrl}} in the collection variables if the server isn't on :3000.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "productId", "value": "1" },
    { "key": "shoeId", "value": "1", "description": "Set to the id of a Running Shoes product (find one with 02 > Search: running shoes)" }
  ],
  "item": [
    {
      "name": "00 Foundation",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        }
      ]
    },
    {
      "name": "01 JSONB",
      "item": [
        {
          "name": "By attributes: color red",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products/by-attributes?filter={\"color\":\"red\"}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "by-attributes"],
              "query": [{ "key": "filter", "value": "{\"color\":\"red\"}" }]
            }
          }
        },
        {
          "name": "By attributes: red + size XL",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products/by-attributes?filter={\"color\":\"red\",\"size\":\"XL\"}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "by-attributes"],
              "query": [{ "key": "filter", "value": "{\"color\":\"red\",\"size\":\"XL\"}" }]
            }
          }
        },
        {
          "name": "By attributes: wireless electronics",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products/by-attributes?filter={\"wireless\":true}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "by-attributes"],
              "query": [{ "key": "filter", "value": "{\"wireless\":true}" }]
            }
          }
        },
        {
          "name": "By attributes: bad JSON (expect 400)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products/by-attributes?filter=not-json",
              "host": ["{{baseUrl}}"],
              "path": ["products", "by-attributes"],
              "query": [{ "key": "filter", "value": "not-json" }]
            }
          }
        },
        {
          "name": "Attributes of one product",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/attributes",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}", "attributes"]
            }
          }
        }
      ]
    },
    {
      "name": "02 Full-text search",
      "item": [
        {
          "name": "Search: wireless headphones",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/search?q=wireless headphones",
              "host": ["{{baseUrl}}"],
              "path": ["search"],
              "query": [{ "key": "q", "value": "wireless headphones" }]
            }
          }
        },
        {
          "name": "Search: websearch syntax (\"yoga mat\" -cotton)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/search?q=\"yoga mat\" -cotton",
              "host": ["{{baseUrl}}"],
              "path": ["search"],
              "query": [{ "key": "q", "value": "\"yoga mat\" -cotton" }]
            }
          }
        },
        {
          "name": "Search: stemming (cleaning -> clean)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/search?q=cleaning",
              "host": ["{{baseUrl}}"],
              "path": ["search"],
              "query": [{ "key": "q", "value": "cleaning" }]
            }
          }
        },
        {
          "name": "Fuzzy: wireles hedphones",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/search/fuzzy?q=wireles hedphones",
              "host": ["{{baseUrl}}"],
              "path": ["search", "fuzzy"],
              "query": [{ "key": "q", "value": "wireles hedphones" }]
            }
          }
        },
        {
          "name": "Fuzzy: tnnis rackt",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/search/fuzzy?q=tnnis rackt",
              "host": ["{{baseUrl}}"],
              "path": ["search", "fuzzy"],
              "query": [{ "key": "q", "value": "tnnis rackt" }]
            }
          }
        },
        {
          "name": "Search: empty q (expect 400)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/search?q=",
              "host": ["{{baseUrl}}"],
              "path": ["search"],
              "query": [{ "key": "q", "value": "" }]
            }
          }
        }
      ]
    },
    {
      "name": "03 pgvector",
      "item": [
        {
          "name": "Find a shoe id (FTS): running shoes",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/search?q=running shoes",
              "host": ["{{baseUrl}}"],
              "path": ["search"],
              "query": [{ "key": "q", "value": "running shoes" }]
            }
          }
        },
        {
          "name": "Similar products to {{shoeId}}",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products/{{shoeId}}/similar",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{shoeId}}", "similar"]
            }
          }
        },
        {
          "name": "Semantic: something to keep my coffee hot",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/search/semantic?q=something to keep my coffee hot",
              "host": ["{{baseUrl}}"],
              "path": ["search", "semantic"],
              "query": [{ "key": "q", "value": "something to keep my coffee hot" }]
            }
          }
        },
        {
          "name": "FTS on the same query (expect 0 rows)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/search?q=something to keep my coffee hot",
              "host": ["{{baseUrl}}"],
              "path": ["search"],
              "query": [{ "key": "q", "value": "something to keep my coffee hot" }]
            }
          }
        },
        {
          "name": "Semantic: a gift for a kid who likes building things",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/search/semantic?q=a gift for a kid who likes building things",
              "host": ["{{baseUrl}}"],
              "path": ["search", "semantic"],
              "query": [{ "key": "q", "value": "a gift for a kid who likes building things" }]
            }
          }
        },
        {
          "name": "Semantic: empty q (expect 400)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/search/semantic?q=",
              "host": ["{{baseUrl}}"],
              "path": ["search", "semantic"],
              "query": [{ "key": "q", "value": "" }]
            }
          }
        }
      ]
    },
    {
      "name": "05 PostGIS",
      "item": [
        {
          "name": "Nearby: Cairo center, 10 km",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/stores/nearby?lat=30.0444&lng=31.2357&km=10",
              "host": ["{{baseUrl}}"],
              "path": ["stores", "nearby"],
              "query": [
                { "key": "lat", "value": "30.0444" },
                { "key": "lng", "value": "31.2357" },
                { "key": "km", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Nearby: Cairo center, 2 km",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/stores/nearby?lat=30.0444&lng=31.2357&km=2",
              "host": ["{{baseUrl}}"],
              "path": ["stores", "nearby"],
              "query": [
                { "key": "lat", "value": "30.0444" },
                { "key": "lng", "value": "31.2357" },
                { "key": "km", "value": "2" }
              ]
            }
          }
        },
        {
          "name": "Nearby: Alexandria, 10 km (expect 0)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/stores/nearby?lat=31.2001&lng=29.9187&km=10",
              "host": ["{{baseUrl}}"],
              "path": ["stores", "nearby"],
              "query": [
                { "key": "lat", "value": "31.2001" },
                { "key": "lng", "value": "29.9187" },
                { "key": "km", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Distance: store 1 to Cairo center",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/stores/1/distance?lat=30.0444&lng=31.2357",
              "host": ["{{baseUrl}}"],
              "path": ["stores", "1", "distance"],
              "query": [
                { "key": "lat", "value": "30.0444" },
                { "key": "lng", "value": "31.2357" }
              ]
            }
          }
        },
        {
          "name": "Nearby: bad lat (expect 400)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/stores/nearby?lat=200&lng=31.2357",
              "host": ["{{baseUrl}}"],
              "path": ["stores", "nearby"],
              "query": [
                { "key": "lat", "value": "200" },
                { "key": "lng", "value": "31.2357" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "06 Unlogged",
      "item": [
        {
          "name": "Cached product (1st call: X-Cache MISS)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/cached",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}", "cached"]
            }
          }
        },
        {
          "name": "Cached product again (X-Cache HIT within 60s)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/cached",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}", "cached"]
            }
          }
        },
        {
          "name": "Cached: unknown id (expect 404)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products/999999/cached",
              "host": ["{{baseUrl}}"],
              "path": ["products", "999999", "cached"]
            }
          }
        },
        {
          "name": "Cached: bad id (expect 400)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products/abc/cached",
              "host": ["{{baseUrl}}"],
              "path": ["products", "abc", "cached"]
            }
          }
        }
      ]
    }
  ]
}
