{
  "name": "pg-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:up": "docker compose up -d --build --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --build --wait && prisma migrate reset --force --skip-seed",
    "migrate": "prisma migrate dev",
    "studio": "prisma studio",
    "seed": "tsx scripts/seed.ts",
    "dev": "tsx watch src/server.ts",
    "jsonb:explain": "tsx scripts/jsonb-explain.ts",
    "search:compare": "tsx scripts/search-compare.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "dotenv": "^16.4.5",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^20.16.0",
    "prisma": "^6.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
