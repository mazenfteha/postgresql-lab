generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String
  description String
  price       Decimal     @db.Decimal(10, 2)
  category    String
  createdAt   DateTime    @default(now())
  attributes  Json        @default("{}")
  // Generated column (see migration). Never read/write through the Prisma client.
  // Postgres stores the generation expression like a default, so Prisma must be told about it
  // via dbgenerated(), otherwise it generates "DROP DEFAULT" (which Postgres rejects).
  search_vector Unsupported("tsvector")? @default(dbgenerated("to_tsvector('english'::regconfig, ((COALESCE(name, ''::text) || ' '::text) || COALESCE(description, ''::text)))"))
  // all-MiniLM-L6-v2 embedding (384 dims), written by scripts/embed-products.ts.
  // Its HNSW index can't be expressed in Prisma 6: delete any generated "DROP INDEX product_embedding_hnsw".
  embedding     Unsupported("vector(384)")?
  orderItems  OrderItem[]

  // Declared here only so Prisma doesn't see drift; the SQL lives in the migrations.
  @@index([attributes(ops: JsonbPathOps)], type: Gin, map: "product_attributes_gin")
  @@index([search_vector], type: Gin, map: "product_search_gin")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "product_name_trgm")
}

model Store {
  id       Int    @id @default(autoincrement())
  name     String
  // PostGIS point (lng/lat on the WGS 84 globe). Read/write only with raw SQL.
  // Required, not optional: the phase spec makes it NOT NULL, and the schema must match the DB.
  location Unsupported("geography(Point, 4326)")

  @@index([location], type: Gist, map: "store_location_gist")
}

// Phase 06 cache tables. @@ignore keeps them out of the Prisma client (raw SQL only),
// but declaring them stops migrate from generating "DROP TABLE" for them.
// Prisma can't express UNLOGGED: that lives in the migration SQL only.
model cache_unlogged {
  key        String   @id
  value      Json
  expires_at DateTime @db.Timestamptz(6)

  @@ignore
}

model cache_logged {
  key        String   @id
  value      Json
  expires_at DateTime @db.Timestamptz(6)

  @@ignore
}

model Customer {
  id     Int     @id @default(autoincrement())
  name   String
  email  String  @unique
  orders Order[]
}

model Order {
  id         Int         @id @default(autoincrement())
  customerId Int
  customer   Customer    @relation(fields: [customerId], references: [id])
  status     String      @default("pending")
  createdAt  DateTime    @default(now())
  items      OrderItem[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id])
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
}
